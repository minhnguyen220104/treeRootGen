

#title: Roots under Hete Soil Imaging

Configuration
#domain: 3.200 3.200 0.005
#dx_dy_dz: 0.005 0.005 0.005
#time_window: 1.5e-08

#pml_cells: 20 20 0 20 20 0

Source - Receiver - Waveform
#waveform: ricker 1 6e8 my_wave

#soil_peplinski: 0.3 0.7 2 2.66 0.01 0.15 hete_soil

#hertzian_dipole: z 0.150 1.510 0.000 my_wave 
#rx: 0.160 1.510 0.000
#src_steps: 0.050 0 0
#rx_steps: 0.050 0 0

Geometry objects read

#geometry_objects_read: 0.100 0.100 0.000 Geometry_ge/geometry_2d.h5 Obj_materials.txt
#fractal_box: 0.100 0.100 0 3.100 1.600 0.005 1.5 1 1 1 20 hete_soil my_fractal_box 89
#geometry_objects_read: 0.100 0.100 0.000 Geometry_ge/root_2d.h5 Root_materials.txt
#geometry_objects_write: 0 0 0 3.200 3.200 0.005 Roots 
#geometry_view: 0 0 0 3.200 3.200 0.005 0.005 0.005 0.005 HeteRoot201 n

        